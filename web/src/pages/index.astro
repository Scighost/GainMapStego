---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
  <!-- ── Hero ──────────────────────────────────────────── -->
  <section class="home-hero">
    <h1 class="home-wordmark">Gain Map&nbsp;<em>Stego</em>&nbsp;</h1>
    <p class="tagline">
      一种基于增益图元数据的图像隐藏方法。<br />
      在支持 <a href="https://sspai.com/post/94425" target="_blank" rel="noopener" class="tagline-link">Gain Map HDR</a> 的<span class="env-tip" tabindex="0" aria-label="支持的环境">环境中<span class="env-tip-popup"><span class="env-tip-title">支持展示 HDR 的环境</span><span class="env-tip-tags"><span class="env-tag">Android 15+</span><span class="env-tag">iOS 18+</span><span class="env-tag">部分浏览器</span></span></span></span>，可以直接展示隐藏的内容。
    </p>
    <div class="hero-cta">
      <a href="/encode" class="btn btn-primary">开始合成</a>
      <a href="/decode" class="btn btn-secondary">解码图片</a>
      <a href="https://github.com/Scighost/GainMapStego" target="_blank" rel="noopener" class="btn btn-ghost">项目介绍</a>
    </div>
  </section>


  <!-- ── Quick decode ───────────────────────────────────── -->
  <section class="home-decode">
    <div class="home-decode-header">
      <h2>快速解码</h2>
      <span class="badge">无需上传</span>
    </div>
    <p class="subtitle">拖入或点击选择一张由本工具生成的图片，立即在本地预览基础图、合成图和增益图。</p>

    <div id="home-drop" class="home-drop-target">
      <div class="drop-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1"/>
          <polyline points="8 12 12 8 16 12"/>
          <line x1="12" y1="8" x2="12" y2="16"/>
        </svg>
      </div>
      <p class="drop-title">拖入或点击选择图片</p>
      <p class="drop-sub">所有处理均在浏览器本地完成，文件不会上传</p>
      <input id="home-file-input" type="file" accept=".jpg,.jpeg,image/jpeg" hidden />
    </div>

    <div id="home-results" class="home-results">
      <figure class="drop-zone static-zone" id="home-result">
        <div class="result-toolbar" role="tablist" aria-label="图像预览">
          <button class="pivot-tab active" type="button" role="tab" aria-selected="true" data-pivot="alt">合成图</button>
          <button class="pivot-tab" type="button" role="tab" aria-selected="false" data-pivot="base">基础图</button>
          <button class="pivot-tab" type="button" role="tab" aria-selected="false" data-pivot="gainmap">增益图</button>
          <span class="zone-dim" id="hdim-active"></span>
          <button id="hbtn-save" class="save-btn" type="button" disabled title="保存合成图">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            保存
          </button>
        </div>
        <div class="img-wrap" role="tabpanel">
          <img id="home-img-alt" class="pivot-panel active" alt="合成图" />
          <img id="home-img-base" class="pivot-panel" alt="基础图" />
          <img id="home-img-gainmap" class="pivot-panel" alt="增益图" />
          <div class="zone-placeholder">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/>
              <polyline points="21 15 16 10 5 21"/>
            </svg>
            <span id="hph-text">合成图将显示在此</span>
          </div>
        </div>
      </figure>
    </div>
  </section>
</BaseLayout>

<script>
import { unpackGainmapJpeg } from '../lib/iso21496.js';
import { reconstructAlternateFromGainMap } from '../lib/image-processing.js';
import { blobToImage, canvasToJpegBlob, downloadBlob, fileToUint8Array, imageBitmapToCanvas, scrollIntoViewIfNeeded } from '../lib/utils.js';
import { createPivot } from '../lib/pivot.js';
import { openLightbox } from '../lib/lightbox.js';

function initHomePage() {
  const dropTarget  = document.getElementById('home-drop');
  const fileInput   = document.getElementById('home-file-input') as HTMLInputElement | null;
  const resultsEl   = document.getElementById('home-results');

  // 如果元素不存在，说明不在首页，直接返回
  if (!dropTarget || !fileInput || !resultsEl) return;

  const imgBase     = document.getElementById('home-img-base') as HTMLImageElement;
  const imgGainmap  = document.getElementById('home-img-gainmap') as HTMLImageElement;
  const imgAlt      = document.getElementById('home-img-alt') as HTMLImageElement;

  const hBtnSave    = document.getElementById('hbtn-save') as HTMLButtonElement;

  /* ── Pivot 预览（与解码页一致） ───────────────────────── */
  type PivotTab = 'alt' | 'base' | 'gainmap';
  const PIVOT_ORDER: PivotTab[] = ['alt', 'base', 'gainmap'];
  const pivot = createPivot({
    order: PIVOT_ORDER,
    buttons: {
      alt:     document.querySelector<HTMLButtonElement>('[data-pivot="alt"]')!,
      base:    document.querySelector<HTMLButtonElement>('[data-pivot="base"]')!,
      gainmap: document.querySelector<HTMLButtonElement>('[data-pivot="gainmap"]')!,
    },
    panels: { alt: imgAlt, base: imgBase, gainmap: imgGainmap },
    labels: { alt: '合成图', base: '基础图', gainmap: '增益图' },
    dimsEl: document.getElementById('hdim-active')!,
    placeholderEl: document.getElementById('hph-text')!,
    saveBtn: hBtnSave,
  });

  // 图片预览（灯箱）
  const _homeImgItems = [
    { el: imgAlt,     label: '合成图' },
    { el: imgBase,    label: '基础图' },
    { el: imgGainmap, label: '增益图' },
  ];
  _homeImgItems.forEach(({ el, label }) => {
    el.style.cursor = 'zoom-in';
    el.addEventListener('click', () => {
      if (!el.getAttribute('src')) return;
      openLightbox({ src: el.src, label });
    });
  });

  let _baseBlob: Blob | null = null;
  let _gainBlob: Blob | null = null;
  let _altBlob:  Blob | null = null;
  let _sourceStem = 'decoded';

  // 点击整个区域（包括按钮）均触发文件选择
  dropTarget.addEventListener('click', () => fileInput.click());

  fileInput.addEventListener('change', () => {
    const f = fileInput.files?.[0];
    if (f) processFile(f);
  });

  dropTarget.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropTarget.classList.add('drag-over');
  });
  dropTarget.addEventListener('dragleave', () => dropTarget.classList.remove('drag-over'));
  dropTarget.addEventListener('drop', (e) => {
    e.preventDefault();
    dropTarget.classList.remove('drag-over');
    const f = e.dataTransfer?.files?.[0];
    if (f) processFile(f);
  });

  async function processFile(file: File) {
    _sourceStem = file.name.replace(/\.[^.]+$/, '');
    resultsEl!.classList.remove('visible');
    hBtnSave.disabled = true;
    // 重置预览 tab：全部显示并回到合成图
    PIVOT_ORDER.forEach(t => pivot.setDims(t, ''));
    pivot.setTabsVisible(PIVOT_ORDER);
    pivot.switchTab('alt');

    // 选择图片后：框内显示文件名 + 右侧转圈，期间禁止再次选择
    dropTarget.classList.add('collapsed', 'busy');
    dropTarget.innerHTML = `<span class="drop-collapsed-name">${file.name}</span>` +
      `<span class="drop-spinner"><svg class="spin-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-label="解码中"><circle cx="12" cy="12" r="9" stroke-opacity=".25"/><path d="M12 3a9 9 0 019 9" stroke-linecap="round"/></svg></span>`;

    // 结束后重写框内容：文件名 + 额外消息 + 重新选择按钮
    const setBoxResult = (extraHtml: string) => {
      dropTarget.classList.remove('busy');
      dropTarget.innerHTML = `<span class="drop-collapsed-name">${file.name}</span>${extraHtml}` +
        `<button class="drop-collapsed-retry" id="home-retry">重新选择</button>`;
      document.getElementById('home-retry')!.addEventListener('click', (e) => {
        e.stopPropagation();
        fileInput!.click();
      });
    };

    try {
      const bytes = await fileToUint8Array(file);
      const { baseJpegBytes, gainmapJpegBytes, metadata } = unpackGainmapJpeg(bytes);

      const baseBlob = new Blob([baseJpegBytes],    { type: 'image/jpeg' });
      const gainBlob = new Blob([gainmapJpegBytes], { type: 'image/jpeg' });

      const [baseBitmap, gainBitmap] = await Promise.all([blobToImage(baseBlob), blobToImage(gainBlob)]);
      const baseCanvas    = imageBitmapToCanvas(baseBitmap);
      const gainMapCanvas = imageBitmapToCanvas(gainBitmap);
      const altCanvas     = reconstructAlternateFromGainMap({ baseCanvas, gainMapCanvas, metadata });
      const altBlob       = await canvasToJpegBlob(altCanvas, 90);

      _baseBlob = baseBlob; _gainBlob = gainBlob; _altBlob = altBlob;

      imgBase.src    = baseCanvas.toDataURL('image/png');
      imgGainmap.src = gainMapCanvas.toDataURL('image/png');
      imgAlt.src     = altCanvas.toDataURL('image/png');
      pivot.setDims('base',    `${baseCanvas.width} × ${baseCanvas.height}`);
      pivot.setDims('gainmap', `${gainMapCanvas.width} × ${gainMapCanvas.height}`);
      pivot.setDims('alt',     `${altCanvas.width} × ${altCanvas.height}`);
      pivot.switchTab('alt');

      hBtnSave.disabled = false;
      resultsEl!.classList.add('visible');
      // 转圈变为重新选择，结果卡片本身就是成功反馈
      setBoxResult('');
      scrollIntoViewIfNeeded(resultsEl!);
    } catch {
      // 尝试将文件渲染为基础图（有效 JPEG 但无增益图）
      try {
        const bm = await blobToImage(file);
        const cv = imageBitmapToCanvas(bm);
        imgBase.src = cv.toDataURL('image/png');
        pivot.setDims('base', `${cv.width} × ${cv.height}`);
        _baseBlob = file;
        // 无增益图：只保留基础图 tab
        pivot.setTabsVisible(['base']);
        pivot.switchTab('base');
        hBtnSave.disabled = false;
        resultsEl!.classList.add('visible');
        setBoxResult('<span class="drop-note">未找到增益图，仅显示原始图像</span>');
        scrollIntoViewIfNeeded(resultsEl!);
      } catch (e2: any) {
        // 解码失败：在选择框内显示提醒内容
        setBoxResult(`<span class="drop-error">解码失败：${e2?.message ?? e2}</span>`);
      }
    }
  }

  /* ── Save ──────────────────────────────────────────────── */
  hBtnSave.addEventListener('click', () => {
    const blobMap: Record<PivotTab, Blob | null> = {
      alt:     _altBlob,
      base:    _baseBlob,
      gainmap: _gainBlob,
    };
    const nameMap: Record<PivotTab, string> = {
      alt:     `${_sourceStem}_alternate.jpg`,
      base:    `${_sourceStem}_base.jpg`,
      gainmap: `${_sourceStem}_gainmap.jpg`,
    };
    const blob = blobMap[pivot.current];
    if (blob) downloadBlob(blob, nameMap[pivot.current]);
  });
}

// 在页面加载和每次导航后初始化
document.addEventListener('astro:page-load', initHomePage);
</script>

<style>
  .tagline-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
    transition: opacity 0.15s;
  }
  .tagline-link:hover {
    opacity: 0.75;
  }
  /* 禁止主页快速解码结果卡片的 hover 动画 */
  .static-zone { cursor: default !important; }
  .static-zone:hover {
    border-color: var(--border) !important;
    background: var(--bg) !important;
  }
  .static-zone:hover .zone-placeholder svg {
    opacity: .35 !important;
    transform: none !important;
  }
  /* 与解码页一致的预览卡片 */
  #home-result {
    background: var(--bg-card);
    border: 1px solid var(--border-lo);
    border-radius: var(--radius-lg);
    min-height: 380px;
  }

  img:not([src]),
  img[src=""] { display: none; }

  .env-tip {
    position: relative;
    display: inline-block;
    color: inherit;
    font: inherit;
    cursor: default;
    user-select: none;
    outline: none;
    text-decoration: none;
    background-image: repeating-linear-gradient(
      to right,
      rgba(128,128,128,0.45) 0px 5px,
      transparent 5px 8px
    );
    background-position: 0 100%;
    background-size: 8px 2px;
    background-repeat: repeat-x;
    padding-bottom: 0;
    transition: background-image 0.15s;
  }
  .env-tip:hover,
  .env-tip:focus,
  .env-tip.open {
    background-image: repeating-linear-gradient(
      to right,
      rgba(128,128,128,0.85) 0px 5px,
      transparent 5px 8px
    );
  }
  .env-tip-popup {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    position: absolute;
    left: 50%;
    bottom: calc(100% + 10px);
    transform: translateX(-50%) translateY(6px);
    min-width: 140px;
    background: var(--bg-card, #1c1c1e);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 0.6em 0.75em 0.65em;
    box-shadow: 0 8px 28px rgba(0,0,0,.28), 0 1px 4px rgba(0,0,0,.12);
    transition: opacity 0.2s, visibility 0.2s, transform 0.2s;
    z-index: 100;
  }
  .env-tip-title {
    display: block;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.01em;
    margin-bottom: 0.5em;
    white-space: nowrap;
  }
  .env-tip-tags {
    display: flex;
    flex-direction: column;
    gap: 0.3em;
  }
  .env-tag {
    display: inline-block;
    padding: 0.18em 0.55em;
    border-radius: 5px;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  /* 箭头 */
  .env-tip-popup::before,
  .env-tip-popup::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 6px solid transparent;
    border-top-color: var(--border);
  }
  .env-tip-popup::after {
    border-top-color: var(--bg-card, #1c1c1e);
    margin-top: -1.5px;
  }
  .env-tip:hover .env-tip-popup,
  .env-tip:focus .env-tip-popup,
  .env-tip.open .env-tip-popup {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }
</style>

<script>
  let _envTipsBound = false;
  function initEnvTips() {
    if (_envTipsBound) return;
    _envTipsBound = true;
    document.addEventListener('click', (e) => {
      const tip = (e.target as Element)?.closest?.('.env-tip');
      if (tip) {
        e.stopPropagation();
        tip.classList.toggle('open');
        return;
      }
      document.querySelectorAll('.env-tip.open').forEach((el) => el.classList.remove('open'));
    });
  }

  document.addEventListener('astro:page-load', initEnvTips);
</script>
